# META-* duplicates so Mac Cmd / Linux Super key triggers the same Alt-bar
# actions. Dual-bind: ALT-X and META-X both fire MULTIACTIONBAR4BUTTON*. Lets
# the wife use Cmd on her MacBook (Arch + Proton) without OS-level remapping.
# If META events don't reach WoW under her Proton/WM setup, this is a no-op.
bind META-` MULTIACTIONBAR4BUTTON1
bind META-1 MULTIACTIONBAR4BUTTON2
bind META-2 MULTIACTIONBAR4BUTTON3
bind META-3 MULTIACTIONBAR4BUTTON4
bind META-4 MULTIACTIONBAR4BUTTON5
bind META-5 MULTIACTIONBAR4BUTTON6
bind META-Q MULTIACTIONBAR4BUTTON8
bind META-E MULTIACTIONBAR4BUTTON10
bind META-R MULTIACTIONBAR4BUTTON11
bind META-T MULTIACTIONBAR4BUTTON12
bind META-F MULTIACTIONBAR2BUTTON5
bind META-G MULTIACTIONBAR2BUTTON6
bind META-Z MULTIACTIONBAR2BUTTON8
bind META-X MULTIACTIONBAR2BUTTON9
bind META-C MULTIACTIONBAR2BUTTON10
bind META-V MULTIACTIONBAR2BUTTON11
bind META-B MULTIACTIONBAR2BUTTON12
