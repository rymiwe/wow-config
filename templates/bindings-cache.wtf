bind W TOGGLEAUTORUN
bind A STRAFELEFT
bind D STRAFERIGHT
bind NUMLOCK NONE
# M3 -> SC_Decurse / SC_Purify: SetupCore sets this in-game (do not seed BUTTON3 NONE)
bind BUTTON4 NONE
bind BUTTON5 NONE
bind ` ACTIONBUTTON1
bind 1 ACTIONBUTTON2
bind 2 ACTIONBUTTON3
bind 3 ACTIONBUTTON4
bind 4 ACTIONBUTTON5
bind 5 ACTIONBUTTON6
bind 6 NONE
bind 7 NONE
bind 8 NONE
bind 9 NONE
bind 0 NONE
bind - NONE
bind = NONE
bind Q ACTIONBUTTON8
bind E ACTIONBUTTON10
bind R ACTIONBUTTON11
bind T ACTIONBUTTON12
bind F MULTIACTIONBAR3BUTTON5
bind G MULTIACTIONBAR3BUTTON6
bind Z MULTIACTIONBAR3BUTTON8
bind X MULTIACTIONBAR3BUTTON9
bind C MULTIACTIONBAR3BUTTON10
bind V MULTIACTIONBAR3BUTTON11
bind B MULTIACTIONBAR3BUTTON12
bind ALT-` MULTIACTIONBAR4BUTTON1
bind ALT-1 MULTIACTIONBAR4BUTTON2
bind ALT-2 MULTIACTIONBAR4BUTTON3
bind ALT-3 MULTIACTIONBAR4BUTTON4
bind ALT-4 MULTIACTIONBAR4BUTTON5
bind ALT-5 MULTIACTIONBAR4BUTTON6
bind ALT-Q MULTIACTIONBAR4BUTTON8
bind ALT-E MULTIACTIONBAR4BUTTON10
bind ALT-R MULTIACTIONBAR4BUTTON11
bind ALT-T MULTIACTIONBAR4BUTTON12
bind ALT-F MULTIACTIONBAR2BUTTON5
bind ALT-G MULTIACTIONBAR2BUTTON6
bind ALT-Z MULTIACTIONBAR2BUTTON8
bind ALT-X MULTIACTIONBAR2BUTTON9
bind ALT-C MULTIACTIONBAR2BUTTON10
bind ALT-V MULTIACTIONBAR2BUTTON11
bind ALT-B MULTIACTIONBAR2BUTTON12
# META-* duplicates so Mac Cmd / Linux Super key triggers the same Alt-bar
# actions. Dual-bind: ALT-X and META-X both fire MULTIACTIONBAR4BUTTON*. Lets
# the wife use Cmd on her MacBook (Arch + Proton) without OS-level remapping.
# If META events don't reach WoW under her Proton/WM setup, this is a no-op.
bind META-` MULTIACTIONBAR4BUTTON1
bind META-1 MULTIACTIONBAR4BUTTON2
bind META-2 MULTIACTIONBAR4BUTTON3
bind META-3 MULTIACTIONBAR4BUTTON4
bind META-4 MULTIACTIONBAR4BUTTON5
bind META-5 MULTIACTIONBAR4BUTTON6
bind META-Q MULTIACTIONBAR4BUTTON8
bind META-E MULTIACTIONBAR4BUTTON10
bind META-R MULTIACTIONBAR4BUTTON11
bind META-T MULTIACTIONBAR4BUTTON12
bind META-F MULTIACTIONBAR2BUTTON5
bind META-G MULTIACTIONBAR2BUTTON6
bind META-Z MULTIACTIONBAR2BUTTON8
bind META-X MULTIACTIONBAR2BUTTON9
bind META-C MULTIACTIONBAR2BUTTON10
bind META-V MULTIACTIONBAR2BUTTON11
bind META-B MULTIACTIONBAR2BUTTON12
bind ; QUESTIE_TOGGLE_JOURNEY
# SHIFT-* bindings: fire the SAME ACTIONBUTTON as the un-modified key.
# Default WoW binds Shift+1..= and Shift+MouseWheel to action-bar PAGE cycling
# (CHANGEACTIONBARLEFT/RIGHT), which conflicts with normal play (accidental
# page swaps mid-combat) and with the ElvUI [mod:shift]1 bar 1 paging.
# Binding SHIFT-X to the matching ACTIONBUTTON neutralizes the defaults.
bind SHIFT-` ACTIONBUTTON1
bind SHIFT-1 ACTIONBUTTON2
bind SHIFT-2 ACTIONBUTTON3
bind SHIFT-3 ACTIONBUTTON4
bind SHIFT-4 ACTIONBUTTON5
bind SHIFT-5 ACTIONBUTTON6
bind SHIFT-Q ACTIONBUTTON8
bind SHIFT-E ACTIONBUTTON10
bind SHIFT-R ACTIONBUTTON11
bind SHIFT-T ACTIONBUTTON12
bind SHIFT-F MULTIACTIONBAR3BUTTON5
bind SHIFT-G MULTIACTIONBAR3BUTTON6
bind SHIFT-Z MULTIACTIONBAR3BUTTON8
bind SHIFT-X MULTIACTIONBAR3BUTTON9
bind SHIFT-C MULTIACTIONBAR3BUTTON10
bind SHIFT-V MULTIACTIONBAR3BUTTON11
# Shift+B opens all bags (Blizzard default). Not mirrored to bar-3 B — Purge is Alt-B.
bind SHIFT-B OPENALLBAGS
bind SHIFT-6 NONE
# Disable Shift+MouseWheel page-cycle defaults (accidental triggers)
bind SHIFT-MOUSEWHEELUP NONE
bind SHIFT-MOUSEWHEELDOWN NONE
