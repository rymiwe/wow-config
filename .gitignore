# Default-deny: ignore everything, then whitelist what we want
*

# Allow repo metadata
!.gitignore
!.gitattributes
!README.md

# Allow per-flavor traversal (matches _anniversary_, _classic_era_, _retail_, _ptr_, etc.)
!_*/

# Custom addons (each flavor has its own AddOns dir)
!_*/Interface/
!_*/Interface/AddOns/
!_*/Interface/AddOns/ElvUIFixes/
!_*/Interface/AddOns/ElvUIFixes/**
!_*/Interface/AddOns/ChatPanelThemes/
!_*/Interface/AddOns/ChatPanelThemes/**
!_*/Interface/AddOns/ZygorSetup/
!_*/Interface/AddOns/ZygorSetup/**
!_*/Interface/AddOns/TSMSetup/
!_*/Interface/AddOns/TSMSetup/**
!_*/Interface/AddOns/SetupCore/
!_*/Interface/AddOns/SetupCore/**
!_*/Interface/AddOns/GuildMotdCycler/
!_*/Interface/AddOns/GuildMotdCycler/**
!_*/Interface/AddOns/ShamanSetup/
!_*/Interface/AddOns/ShamanSetup/**
!_*/Interface/AddOns/DruidSetup/
!_*/Interface/AddOns/DruidSetup/**
!_*/Interface/AddOns/HunterSetup/
!_*/Interface/AddOns/HunterSetup/**
!_*/Interface/AddOns/PaladinSetup/
!_*/Interface/AddOns/PaladinSetup/**
!_*/Interface/AddOns/WarriorSetup/
!_*/Interface/AddOns/WarriorSetup/**
!_*/Interface/AddOns/MageSetup/
!_*/Interface/AddOns/MageSetup/**
!_*/Interface/AddOns/PriestSetup/
!_*/Interface/AddOns/PriestSetup/**
!_*/Interface/AddOns/RogueSetup/
!_*/Interface/AddOns/RogueSetup/**
!_*/Interface/AddOns/WarlockSetup/
!_*/Interface/AddOns/WarlockSetup/**

# Distribution (templates and install scripts at repo root)
!templates/
!templates/**
!install.ps1
!install.sh
!install.bat
!README.md
!INSTALL.txt
!scripts/
!scripts/**
!docs/
!docs/**
!.claude/
!.claude/**

# WTF tree (configs and saved variables)
!_*/WTF/
!_*/WTF/Config.wtf
!_*/WTF/Account/
!_*/WTF/Account/*/
!_*/WTF/Account/*/bindings-cache.wtf
!_*/WTF/Account/*/macros-cache.txt
!_*/WTF/Account/*/SavedVariables/
!_*/WTF/Account/*/SavedVariables/*.lua

# Per-character files
!_*/WTF/Account/*/*/
!_*/WTF/Account/*/*/*/
!_*/WTF/Account/*/*/*/AddOns.txt
!_*/WTF/Account/*/*/*/bindings-cache.wtf
!_*/WTF/Account/*/*/*/chat-cache.txt
!_*/WTF/Account/*/*/*/edit-mode-cache-character.txt
!_*/WTF/Account/*/*/*/layout-local.txt
!_*/WTF/Account/*/*/*/macros-cache.txt
!_*/WTF/Account/*/*/*/SavedVariables/
!_*/WTF/Account/*/*/*/SavedVariables/*.lua

# Even within whitelisted paths, always ignore noise
*.bak
*.old
*.md5
**/config-cache.wtf
**/tts-cache-*.txt
**/Cache/
**/Logs/

# TradeSkillMaster: Desktop App rewrites these constantly; not worth tracking
**/SavedVariables/TradeSkillMaster.lua
**/SavedVariables/TradeSkillMaster_AppHelper.lua
**/SavedVariables/TradeSkillMaster*.lua.bak
