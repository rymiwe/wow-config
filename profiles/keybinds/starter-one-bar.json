{
  "id": "starter-one-bar",
  "title": "Starter: any class, one bar",
  "subtitle": "No clicking: A/D strafe, 1-4 Q E R F C and mouse buttons run the main bar",
  "summary": "Main bar on 1-4 Q E R F C plus mouse 3/4/5. A/D strafe.",
  "class": "any",
  "level": null,
  "levels": "1-60",
